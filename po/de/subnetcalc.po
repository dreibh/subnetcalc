#: src/subnetcalc.cc:1147
msgid "Address"
msgstr "Adresse"

#. TRANSLATORS: Output field label for the network IP address
#: src/subnetcalc.cc:1153
msgid "Network"
msgstr "Netzwerk"

#. TRANSLATORS: Output field label for the subnet mask
#: src/subnetcalc.cc:1155
msgid "Netmask"
msgstr "Netzmaske"

#. TRANSLATORS: Output field label for the broadcast address
#: src/subnetcalc.cc:1161
msgid "Broadcast"
