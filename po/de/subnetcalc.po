#. TRANSLATORS: Error message when attempting to generate a unique local
#. address without specifying an IPv6 target address.
#: src/subnetcalc.cc:308
msgid "ERROR: An IPv6 address must be given to generate a unique local address!"
msgstr "FEHLER: Um eine eindeutige lokale Adresse zu generieren, muss eine IPv6-Adresse angegeben werden!"

#. TRANSLATORS: Status message when generating unique local address:
#. {0} = random number generator device path (e.g. /dev/urandom)
#: src/subnetcalc.cc:319 src/subnetcalc.cc:339
#, no-c-format, c++-format
msgid "Generating Unique Local IPv6 address (using {0}) ..."
msgstr "Unique-Local-IPv6-Adresse wird generiert (mit {0}) ..."

#. TRANSLATORS: Error message when reading from random device fails:
#. {0} = random device file path
#: src/subnetcalc.cc:324
#, no-c-format, c++-format
msgid "ERROR: Unable to read from {0}!"
msgstr "FEHLER: Lesen von {0} nicht möglich!"

#. TRANSLATORS: Error message when opening random device fails:
#. {0} = random device file path
#: src/subnetcalc.cc:331
#, no-c-format, c++-format
msgid "ERROR: Unable to open {0}!"
msgstr "FEHLER: {0} konnte nicht geöffnet werden!"

